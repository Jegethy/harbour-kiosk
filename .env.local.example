# Copy to .env.local and fill in from your Supabase project settings.
# Project Settings -> API

# Safe to ship to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# SERVER ONLY. One-time code for pairing the lobby tablet at /kiosk/setup.
#
# Required in production: without it the kiosk endpoints refuse every request
# rather than serving an open endpoint to the internet. Generate with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
#
# This also signs the device cookie, so changing it revokes every paired
# tablet and they must be set up again. That is the revocation mechanism.
KIOSK_SETUP_TOKEN=

# DEV ONLY. Set to "true" to show the fob hardware simulator on /kiosk (staff
# session required) and in the Add Visitor dialog. Must be absent or "false"
# in production. See DEPLOYMENT.md for how to remove the simulator entirely.
NEXT_PUBLIC_ENABLE_FOB_SIMULATOR=false

# SERVER ONLY. Bypasses Row Level Security.
#
# This key is what lets the kiosk write check-ins without giving the tablet
# any direct database access. It must never be imported into a client
# component, never be prefixed NEXT_PUBLIC_, and never be committed.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
